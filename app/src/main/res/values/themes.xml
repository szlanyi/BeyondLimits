<resources>

    <!-- Splash Theme -->
    <style name="Theme.BeyondLimits.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/beyondlogo</item> <!-- dein PNG -->
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.BeyondLimits.NoActionBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Haupttheme -->
    <style name="Theme.BeyondLimits" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- NoActionBar -->
    <style name="Theme.BeyondLimits.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.BeyondLimits.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.BeyondLimits.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>